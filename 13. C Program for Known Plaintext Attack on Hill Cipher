#include <stdio.h>

int modInverse(int a)
{
    int i;

    for(i = 1; i < 26; i++)
    {
        if((a * i) % 26 == 1)
            return i;
    }

    return -1;
}

int main()
{
    int P[2][2] = {
        {7, 4},
        {19, 7}
    };

    int C[2][2] = {
        {19, 11},
        {8, 13}
    };

    int det, invDet;
    int Pinv[2][2];
    int K[2][2];

    /* Determinant of P */
    det = (P[0][0] * P[1][1] -
           P[0][1] * P[1][0]) % 26;

    if(det < 0)
        det += 26;

    invDet = modInverse(det);

    if(invDet == -1)
    {
        printf("Inverse does not exist.\n");
        return 0;
    }

    /* Inverse of P */
    Pinv[0][0] = (invDet * P[1][1]) % 26;
    Pinv[0][1] = (-invDet * P[0][1]) % 26;
    Pinv[1][0] = (-invDet * P[1][0]) % 26;
    Pinv[1][1] = (invDet * P[0][0]) % 26;

    /* Convert negative values */
    if(Pinv[0][1] < 0)
        Pinv[0][1] += 26;

    if(Pinv[1][0] < 0)
        Pinv[1][0] += 26;

    /* K = C * P^-1 */
    K[0][0] = (C[0][0] * Pinv[0][0] +
               C[0][1] * Pinv[1][0]) % 26;

    K[0][1] = (C[0][0] * Pinv[0][1] +
               C[0][1] * Pinv[1][1]) % 26;

    K[1][0] = (C[1][0] * Pinv[0][0] +
               C[1][1] * Pinv[1][0]) % 26;

    K[1][1] = (C[1][0] * Pinv[0][1] +
               C[1][1] * Pinv[1][1]) % 26;

    printf("Recovered Key Matrix:\n");

    printf("%d %d\n", K[0][0], K[0][1]);
    printf("%d %d\n", K[1][0], K[1][1]);

    return 0;
}
