#include <stdio.h>
#include <string.h>

char matrix[5][5] = {
    {'M','O','N','A','R'},
    {'C','H','Y','B','D'},
    {'E','F','G','I','K'},
    {'L','P','Q','S','T'},
    {'U','V','W','X','Z'}
};

void find(char ch, int *r, int *c)
{
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *r = i;
                *c = j;
                return;
            }
        }
    }
}

int main()
{
    char cipher[] =
    "KXJEYUREBEZWEHEWRYTUHEYFSKREHEGOYFIWTTTUOLKSY"
    "CAJPOBOTEIZONTXBYBNTGONEYCUZWRGDSONSXBOUYWRHE"
    "BAAHYUSEDQ";

    int i, r1, c1, r2, c2;

    printf("Decrypted Text:\n");

    for(i = 0; cipher[i] != '\0'; i += 2)
    {
        find(cipher[i], &r1, &c1);
        find(cipher[i + 1], &r2, &c2);

        /* Same row */
        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 4) % 5],
                   matrix[r2][(c2 + 4) % 5]);
        }

        /* Same column */
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 4) % 5][c1],
                   matrix[(r2 + 4) % 5][c2]);
        }

        /* Rectangle rule */
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    return 0;
}
