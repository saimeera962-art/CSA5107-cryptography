#include <stdio.h>

int main()
{
    char text[100];
    int i,a=5,b=8,inv=21;

    printf("Enter Cipher Text: ");
    scanf("%s",text);

    for(i=0;text[i]!='\0';i++)
        if(text[i]>='A'&&text[i]<='Z')
            text[i]=((inv*((text[i]-'A'-b+26)%26))%26)+'A';

    printf("Plain Text: %s",text);

    return 0;
}
