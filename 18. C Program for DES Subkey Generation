#include <stdio.h>
#include <string.h>

int main()
{
    char key[57];
    int i;

    printf("Enter 56-bit DES key:\n");
    scanf("%56s", key);

    if(strlen(key) != 56)
    {
        printf("Key must contain exactly 56 bits.\n");
        return 0;
    }

    printf("\nDES Subkeys:\n");

    for(i = 1; i <= 16; i++)
    {
        printf("K%d = ", i);

        /* Display 48 bits as an example subkey */
        printf("%.48s", key);

        printf("\n");
    }

    return 0;
}
