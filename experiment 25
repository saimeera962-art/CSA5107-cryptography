#include <stdio.h>

long long gcd(long long a, long long b) {
    while (b != 0) {
        long long temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    long long n, message, factor;

    printf("Enter n: ");
    scanf("%lld", &n);

    printf("Enter known plaintext block: ");
    scanf("%lld", &message);

    factor = gcd(message, n);

    if (factor > 1 && factor < n) {
        printf("Factor found = %lld\n", factor);
        printf("Other factor = %lld\n", n / factor);
        printf("RSA modulus can now be factored!\n");
    } else {
        printf("No useful factor found.\n");
    }

    return 0;
}
