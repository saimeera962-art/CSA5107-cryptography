#include <stdio.h>

int modInverse(int a, int m)
{
    int x;
    for(x = 1; x < m; x++)
    {
        if((a * x) % m == 1)
            return x;
    }
    return -1;
}

int main()
{
    char cipher[100];
    int a = 3, b = 16;     // Keys obtained using frequency analysis
    int a_inv = modInverse(a, 26);
    int i, p;

    printf("Enter Cipher Text (Uppercase): ");
    scanf("%s", cipher);

    printf("Decrypted Text: ");

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(cipher[i] >= 'A' && cipher[i] <= 'Z')
        {
            p = (a_inv * ((cipher[i] - 'A') - b + 26)) % 26;
            printf("%c", p + 'A');
        }
    }

    return 0;
}
