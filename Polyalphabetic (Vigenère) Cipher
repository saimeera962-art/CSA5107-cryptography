#include <stdio.h>
#include <string.h>

int main() {
    char text[100], key[100];
    int i;

    printf("Enter Text: ");
    gets(text);

    printf("Enter Key: ");
    gets(key);

    for(i=0;text[i];i++)
        if(text[i]>='A'&&text[i]<='Z')
            text[i]=((text[i]-'A'+key[i%strlen(key)]-'A')%26)+'A';

    printf("Cipher Text: %s",text);

    return 0;
}
