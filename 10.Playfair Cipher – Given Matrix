#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if(ch == 'J')
        ch = 'I';

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char text[] = "MUSTSEEYOUOVERCADOGANWESTCOMINGATONCE";
    char clean[100];
    int i, n = 0;
    int r1, c1, r2, c2;

    /* Remove non-alphabetic characters */
    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            clean[n++] = toupper(text[i]);
        }
    }

    clean[n] = '\0';

    printf("Plain Text: %s\n", clean);
    printf("Cipher Text: ");

    for(i = 0; i < n; i += 2)
    {
        findPosition(clean[i], &r1, &c1);
        findPosition(clean[i + 1], &r2, &c2);

        /* Same row */
        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }

        /* Same column */
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }

        /* Rectangle rule */
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    return 0;
}
