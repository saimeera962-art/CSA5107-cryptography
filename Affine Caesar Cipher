#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int a,b,i;

    printf("Enter Text: ");
    scanf("%s",text);

    printf("Enter a and b: ");
    scanf("%d%d",&a,&b);

    for(i=0;text[i]!='\0';i++)
        if(text[i]>='A'&&text[i]<='Z')
            text[i]=((a*(text[i]-'A')+b)%26)+'A';

    printf("Cipher Text: %s",text);

    return 0;
}
